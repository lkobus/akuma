/--------------------------------------------------------
/村莊5的 商店老闆
# 2
# 8
# 2
# "商店老闆"
# BASIC
# 100
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "你好.請挑挑看."
@ TALK "有需要的嗎?"
@ WAIT
@ IF NUM HAVE 151 THEN GO_DOWN 山蔘1
* 施主商店老闆
@ CLEAR_BUFFER
@ BOX BLUE 6
@ COLOR 250 250 0
@ PLAY 3.WAV
@ SELECT 250 250 255
CASE "買入裝備" GO_DOWN 挑選裝備1
CASE "賣出裝備" GO_DOWN 賣出裝備
CASE "買入道具" GO_DOWN 買入道具3
CASE "賣出道具" GO_DOWN 賣出道具
CASE "與店主對話" GO_DOWN T5-2
CASE "<退出>" GO_DOWN 結束
SELECT_END
@ END

* T5-2
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ SELECT 255 255 255
CASE "<關於魔怪>" GO_DOWN T5-A
CASE "<關於千鬼神>" GO_DOWN T5-B
CASE "<關於雷旗仵獅魔族> " GO_DOWN T5-C
CASE "<結束談話>" GO_UP 施主商店老闆
SELECT_END
@ END

* T5-A
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "周圍的魔怪?你..你知道你現在已"
@ TALK "來到了地下世界嗎?"
@ TALK "不過有外部的人來到這裡的樣子"
@ TALK "來看,表示人間與魔界的戰爭"
@ TALK "也近了."
@ WAIT
@ CLEAR_BUFFER
@ TALK "現在所有的魔族都在自己的領域"
@ TALK "準備戰爭.那戰爭暗示著比攻打人界更重要的"
@ TALK "其實是地下世界的霸權."
@ TALK "也許,如果魔族同心協力了,"
@ TALK "人界可能早已若在它們手中了."
@ WAIT
@ CLEAR_BUFFER
@ SELECT 255 255 255
CASE "<關於千鬼神的手下魔族>" GO_DOWN T5-A-1
SELECT_END
@ END

* T5-A-1
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "千鬼神的手下魔族的話..."
@ TALK "西方城的雙頭魔神.是過去千鬼神在與"
@ TALK "魔界的戰爭中,立下了輝煌的功勞的它."
@ TALK "在千鬼神被封印時得到它的眼睛."
@ TALK "東方城的秤魔王.它以可怕的威力"
@ TALK "讓魔怪們活在恐懼之中.聽說它得到了"
@ TALK "千鬼神的眼睛."
@ TALK "它們倆是代表魔界的魔族."
@ WAIT
@ CLEAR_BUFFER
@ TALK "它們雖然原本是千鬼神的手下..."
@ TALK "自從千鬼神被封印得到千鬼神的能力"
@ TALK "它們就把地下世界分成兩伴佔有了.."
@ WAIT
@ GO_UP T5-2
@ END

* T5-B
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "千鬼神..?"
@ TALK "當然,雖然千鬼神被稱為有史以來"
@ TALK "最偉大的魔族,不過現在已不行了."
@ TALK "因為,它把自己所有的力量分給手下"
@ TALK "後,它的手下又把地下世界平分了"
@ TALK "所以它已經使不上任何力量"
@ TALK "聽說隱居在某個地方吧..."
@ WAIT
@ CLEAR_BUFFER
@ TALK "也有聽說它在地上世界"
@ TALK "得到了痛哭之劍..."
@ WAIT
@ CLEAR_BUFFER
@ TALK "不過.."
@ TALK "也許千鬼神才是真正希望魔族間"
@ TALK "起戰爭的.要等雙頭魔神和秤魔王死了"
@ TALK "它才有辦法拿回原本屬於自己的能力.."
@ WAIT
@ CLEAR_BUFFER
@ TALK "在千鬼神把自己的能力分給雙頭魔神與秤魔王後"
@ TALK "受到背叛的事你也知道吧?"
@ WAIT
@ GO_UP T5-2 

* T5-C
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "雷旗仵獅魔族的話..."
@ TALK "你是指魔女蕾蒂娜和魔道士雷旗仵獅吧?"
@ TALK "他們是這魔界裡偉大的人物.."
@ WAIT
@ CLEAR_BUFFER
@ TALK "但是..受到雙頭魔神和秤魔王的.."
@ TALK "超級詛咒..已經沒有任何力量了."
@ TALK "那些魔怪..都會怕他們.."
@ TALK "也許..拖到現在才要攻打人界"
@ TALK "是因為他們在守著.."
@ CLEAR_BUFFER
@ TALK "不過..現在..他們已失去所有的力量了.."
@ TALK "世界會變什麼樣子..沒有人會知道.."
@ WAIT
@ GO_UP T5-2 


