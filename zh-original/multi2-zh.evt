* 施主魔女
@ CLEAR_BUFFER
@ COLOR 240 20 190
@ IF LEARN_MAGIC THEN GO_DOWN MAGIC_STOP
@ BOX BLUE 5
@ FACE 6 "魔法所魔女" 240 20 190
@ TALK "找我有什麼事嗎?"
@ WAIT
@ CLEAR_BUFFER
@ COLOR 250 250 0
@ PLAY 7.WAV
@ SELECT 250 250 250
CASE "與老闆談話" GO_DOWN T5-3
CASE "魔法訓練" GO_DOWN 魔法訓練1
CASE "<退出>" GO_DOWN 結束
SELECT_END

* T5-3
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 6 "魔法所魔女" 240 20 190
@ COLOR 240 20 190
