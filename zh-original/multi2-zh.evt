/村莊5之鐵匠
# 1
# 8
# 1
# "鐵匠"
# BASIC
# 100
@ IF ITEM HAVE 213 THEN GO_DOWN 峽谷茶1
@ IF NUM HAVE 105 THEN GO_DOWN 小偷1
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "歡迎光臨~賣裝備兼修理."
@ TALK "需要幫忙嗎~"
@ WAIT
* 施主鐵匠
@ CLEAR_BUFFER
@ COLOR 250 250 0
@ PLAY 1.WAV
@ SELECT 255 255 255
CASE "買入裝備" GO_DOWN 挑選裝備2
CASE "賣出裝備" GO_DOWN 賣出裝備
CASE "維修裝備" GO_DOWN 維修裝備
CASE "與店主對話" GO_DOWN T5-1
CASE "<退出>" GO_DOWN 結束
SELECT_END
@ END

* T5-1
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ SELECT 255 255 255
CASE "<關於地下世界>" GO_DOWN T5-1A
CASE "<關於千鬼神>" GO_DOWN T5-1B
CASE "<關於雷旗仵獅魔族>" GO_DOWN T5-1C
CASE ""
CASE "<結束談話>" GO_UP 施主鐵匠
SELECT_END
@ END

* T5-1A
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "你是怎麼進到這地下世界的?"
@ TALK "這地下世界佈有絕境所以"
@ TALK "除了魔族之外應該進不來呀?"
@ WAIT
@ CLEAR_BUFFER
@ SELECT 255 255 255
CASE "<關於你在這裡的理由>" GO_DOWN T5-1A-1
SELECT_END
@ END

* T5-1A-1
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "你在問我在這裡的理由嗎?"
@ TALK "這地下世界的魔族很久以前"
@ TALK "就開始準備與人界之戰爭..."
@ TALK "它們首先先將人界的人們綁來"
@ TALK "學會他們的技術."
@ TALK "我們是被選出來的實驗對象..."
@ WAIT
@ CLEAR_BUFFER
@ TALK "被抓來的我們,在魔族的支配下..向它們"
@ TALK "保障會將所有的技術傳輸給它們,才得以"
@ TALK "保住性命.."
@ TALK ""
@ TALK "而且..因為我們自己自動提供裝備"
@ TALK "給魔族因此我們也得到不少"
@ TALK "方便.."
@ WAIT
@ CLEAR_BUFFER
@ TALK "要說我們和魔族是一夥的,我們也無話可說."
@ TALK "但是..對於像我們這樣,在臨死邊緣的人來說"
@ TALK "這是應該的."
@ WAIT
@ GO_UP T5-1
@ END

* T5-1B
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "千鬼神.."
@ TALK "不管是在多高職位的魔怪"
@ TALK "在這裡是不能隨便叫千鬼神的名字."
@ TALK "尤其在這地下世界.."
@ WAIT
@ CLEAR_BUFFER
@ TALK "你知道千鬼神,在北貴城與痛哭之武士作戰到"
@ TALK "最後一刻的事嗎?"
@ TALK "要解開絕境將所有的魔怪"
@ TALK "放出來的計劃沒有達成,反而"
@ TALK "造成讓自己被封印在痛哭之劍"
@ TALK "的危機"
@ WAIT
@ CLEAR_BUFFER
@ TALK "結果千鬼神在被封印之前一瞬間"
@ TALK "將自己的能力全部分給自己的心復"
@ TALK "之後被封印了!"
@ TALK "雖然..千鬼神被封印.."
@ TALK "傳受它能力的手下卻在這"
@ TALK "地下世界培養自己的力量.."
@ TALK "準備攻擊人界"
@ WAIT
@ CLEAR_BUFFER
@ TALK "現在這地下世界陷入一片混亂."
@ TALK "它那四個心復不知道是在想些"
@ TALK "什麼..窩在各自的地區..."
@ TALK "為了攻打人界應該要出所有的力量"
@ TALK "不過很奇怪的,它們卻只派少數的魔怪到地上世界"
@ TALK "其餘的全都駐紮在地下世界"
@ WAIT
@ CLEAR_BUFFER
@ TALK "我在猜... 它們應該是互相想趁"
@ TALK "對方沒有兵力的時候占有這地下世界..."
@ WAIT
@ CLEAR_BUFFER
@ TALK "還有.. 這是秘密.. 聽說千鬼神.."
@ TALK "在地上世界得到痛哭之劍了..."
@ TALK "再下來.. 這地下世界也會颳起血風.."
@ WAIT
@ GO_UP T5-1
@ END

* T5-1C
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "你..你是問關於雷旗仵獅魔族的是嗎?"
@ TALK "它們雖然擁有很大的力量..但被魔咒所綑綁..."
@ TALK "無法用力的..很可憐的一群..."
@ WAIT
@ CLEAR_BUFFER
@ TALK "魔女蕾蒂娜和魔道士雷旗仵獅因受到"
@ TALK "秤魔王以及雙頭魔神的超級咒術以至"
@ TALK "無法再使力了.."
@ TALK "真是可悲的命運啊.."
@ TALK "它是我們在地下世界唯一的代言人呢..."
@ WAIT
@ GO_UP T5-1
@ END

* 小偷1
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "喂!老闆!"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "喔..你們..你們是退魔師吧.."
@ TALK "找我有啥事?來買武器嗎?"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "你知道關於出現在魔怪墓地的"
@ TALK "鬼神嗎?"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "嗯!你在說什麼?!"
@ TALK "我根本就不知道那種事!!"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "喔..是嗎?"
@ TALK "那幸好...!"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "什..什麼?"
@ TALK "什麼幸好?"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "據說那魔怪為了報仇.."
@ TALK "會到這村莊來呢..."
@ TALK "我是來告訴這支新聞的."
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "啊!!那是真的嗎?!"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "大叔請你也告訴村裡的人."
@ TALK "這件事事關人命!"
@ TALK "那.."
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "等!等一下!!!"
@ TALK "我...請..請聽聽我的話!!"
@ TALK "其實..是我把鬼魂的箭拿來的.."
@ TALK "說實在..我並沒想到事情會變成這樣.."
@ WAIT
@ CLEAR_BUFFER
@ TALK "拜..拜託你!!"
@ TALK "我把箭給你,你去幫我哄哄鬼魂好嗎?"
@ TALK "還有..這些..是報酬!!"
@ GIVE MONEY 5000
@ TALK "5000銅幣.."
@ TALK "拜託你了!!"
@ WAIT
@ CLEAR_BUFFER
@ TALK "我..現在開始我要躲起來生活了.."
@ TALK "那..我就相信你了!"
@ REMOVE NUM_TO_ALL 105
@ GIVE ITEM 55 1
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "呼..我的騙局比預期..還算成功呢?"
@ TALK "再來..再去找那鬼魂就可以了."
@ WAIT
@ END

* 峽谷茶1
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "你好~我是從熊岩村帶"
@ TALK "峽谷茶葉來的."
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "喔..你把峽谷茶葉帶來了!"
@ TALK "謝謝!!"
@ TALK "我剛好要用到峽谷茶葉.."
@ WAIT
@ CLEAR_BUFFER
@ TALK "我說好要給多少錢的..?"
@ TALK "5000 銅幣?還是6000銅幣..?"
@ TALK "不....是7000銅幣嗎?!"
@ CLEAR_BUFFER
@ SELECT 255 255 255
CASE "<是 5000 銅幣.>" GO_DOWN 峽谷茶1-1
CASE "<是 6000 銅幣.>" GO_DOWN 峽谷茶1-2
CASE "<是 7000 銅幣.>" GO_DOWN 峽谷茶1-3
SELECT_END

