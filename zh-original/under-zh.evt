/劇本　第二部
/--------------------------------------------------------
/村莊5之鐵匠
# 1
# 8
# 1
# "鐵匠"
# BASIC
# 100
@ IF ITEM HAVE 213 THEN GO_DOWN 峽谷茶1
@ IF NUM HAVE 105 THEN GO_DOWN 小偷1
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "歡迎光臨，賣裝備兼修理。"
@ TALK "需要幫忙嗎？"
@ WAIT
* 施主鐵匠
@ CLEAR_BUFFER
@ COLOR 250 250 0
@ PLAY 1.WAV
@ SELECT 255 255 255
CASE "買入裝備" GO_DOWN 挑選裝備2
CASE "賣出裝備" GO_DOWN 賣出裝備
CASE "維修裝備" GO_DOWN 維修裝備
CASE "與店主對話" GO_DOWN T5-1
CASE "離開" GO_DOWN 結束
SELECT_END
@ END

* T5-1
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ SELECT 255 255 255
CASE "<關於地下世界>" GO_DOWN T5-1A
CASE "<關於千鬼神>" GO_DOWN T5-1B
CASE "<關於雷旗仵獅魔族>" GO_DOWN T5-1C
CASE ""
CASE "<結束談話>" GO_UP 施主鐵匠
SELECT_END
@ END

* T5-1A
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "你是怎麼進到這地下世界的？"
@ TALK "這地下世界佈有結界，"
@ TALK "所以除了魔族之外應該進不來呀？"
@ WAIT
@ CLEAR_BUFFER
@ SELECT 255 255 255
CASE "<關於你在這裡的理由>" GO_DOWN T5-1A-1
SELECT_END
@ END

* T5-1A-1
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "你在問我在這裡的理由嗎？"
@ TALK "這地下世界的魔族，"
@ TALK "很久以前就開始準備與人界之戰爭。"
@ TALK "它們首先先將地上世界的人類綁來，"
@ TALK "學習他們的技術。"
@ TALK "我們就是這些被抓來的實驗對象。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "被抓來的我們，在魔族的脅迫下。"
@ TALK "向它們保障會將所有的技術傳輸給它們，"
@ TALK "才得以保住性命。"
@ TALK ""
@ TALK "而且，因為我們自己自動提供武器裝備給魔族，"
@ TALK "因此我們也得到不少方便。"
@ TALK ""
@ WAIT
@ CLEAR_BUFFER
@ TALK "要說我們和魔族是一夥的，我們也無話可說。"
@ TALK "但是……對於像我們這樣，"
@ TALK "在臨死邊緣的人來說這也是無可奈何的。"
@ WAIT
@ GO_UP T5-1
@ END

* T5-1B
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "千鬼神！！"
@ TALK "不管是在職位多高的魔怪，"
@ TALK "在這裡是不能隨便直呼千鬼神的名字。"
@ TALK "尤其在這地下世界……。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "你知道千鬼神在北貴城"
@ TALK "與持有痛哭之劍的武士作戰到最後一刻的事嗎？"
@ TALK "要解開結界將所有的魔怪放出來的計劃"
@ TALK "不但沒有達成。"
@ TALK "反而造成讓自己"
@ TALK "被封印在痛哭之劍的危機。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "千鬼神在被封印前的一瞬間，"
@ TALK "將自己的能力全部分給自己的心腹，"
@ TALK "然後被封印了！"
@ TALK "所以雖然千鬼神被封印了，"
@ TALK "但傳承它能力的手下卻在這地下世界"
@ TALK "培養自己的力量，"
@ TALK "準備攻擊人界。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "現在這地下世界陷入一片混亂，"
@ TALK "它那四個心腹不知道是在想些什麼？"
@ TALK "窩在各自的地盤中。"
@ TALK "為了攻打人界應該要出所有的力量，"
@ TALK "不過很奇怪的，它們卻只派少數的魔怪到地上世界。"
@ TALK "其餘的全都駐紮在地下世界。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "我在猜……它們應該是互相想趁對方沒有兵力的時候"
@ TALK "獨自占有這地下世界。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "還有……這是秘密，"
@ TALK "聽說千鬼神在地上世界得到痛哭之劍了，"
@ TALK "接下來，這地下世界也會颳起腥風血雨。"
@ WAIT
@ GO_UP T5-1
@ END

* T5-1C
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "你是問關於雷旗仵獅魔族的是嗎？"
@ TALK "它們雖然擁有很大的力量，"
@ TALK "但被魔咒所綑綁，無法使用法力。很可憐的一群……。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "魔女蕾蒂娜和魔道士雷旗仵獅"
@ TALK "因受到秤魔王以及雙頭魔神的超級咒術"
@ TALK "以致無法再使用法力了。"
@ TALK "真是可悲的命運啊！"
@ TALK "它們是我們在地下世界唯一的代言人呢？"
@ WAIT
@ GO_UP T5-1
@ END

* 小偷1
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "喂！老闆。"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "喔！你們是退魔師吧。"
@ TALK "找我有啥事？來買武器嗎？"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "你知道關於出現在"
@ TALK "魔物的墳墓的鬼神嗎？"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "嗯！你在說什麼？！"
@ TALK "我根本就不知道那種事！！"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "喔……是嗎？"
@ TALK "那幸好……！"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "什……什麼？"
@ TALK "什麼幸好？"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "據說那魔怪為了報仇，"
@ TALK "會到這村莊來呢！"
@ TALK "我是來告訴傳達這消息的。"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "啊！！那是真的嗎？！"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "大叔請你也告訴村裡的人，"
@ TALK "這件事事關全村人的生命安全！"
@ TALK "那……。"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "等…等一下！！！"
@ TALK "我…請…請聽聽我的話！"
@ TALK "其實是我把鬼魂的箭拿來的，"
@ TALK "說實在我並沒想到事情會變成這樣。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "拜…拜託你！！"
@ TALK "我把箭給你，你去幫我哄哄那鬼神好嗎？"
@ TALK "還有，這些是報酬！！"
@ GIVE MONEY 5000
@ TALK "5000枚銅幣。"
@ TALK "拜託你了！！"
@ WAIT
@ CLEAR_BUFFER
@ TALK "我…從現在開始我要躲起來生活了。"
@ TALK "那…我就拜託你了！"
@ REMOVE NUM_TO_ALL 105
@ GIVE ITEM 55 1
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "呼…我的騙局比預期的還成功呢？"
@ TALK "再來只要去找那鬼魂就可以了。"
@ WAIT
@ END

* 峽谷茶1
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "你好，"
@ TALK "我受人之託從雄石村帶來了峽谷茶葉。"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "喔！你把峽谷茶葉帶來了。"
@ TALK "謝謝！！"
@ TALK "我剛好要用到峽谷茶葉。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "我說好要給多少錢的？"
@ TALK "5000枚銅幣？還是6000枚銅幣？"
@ TALK "不不不……是7000枚銅幣嗎？！"
@ CLEAR_BUFFER
@ SELECT 255 255 255
CASE "<是5000枚銅幣>" GO_DOWN 峽谷茶1-1
CASE "<是6000枚銅幣>" GO_DOWN 峽谷茶1-2
CASE "<是7000枚銅幣>" GO_DOWN 峽谷茶1-3
SELECT_END

* 峽谷茶1-1
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "是嗎？"
@ TALK "你真是一位很誠實的人。"
@ TALK "我記的不太清楚，其實你可以騙我的。"
@ TALK "好！加上報酬我付你7000枚銅幣吧！"
@ GIVE MONEY 7000
@ WAIT
@ CLEAR_BUFFER
@ TALK "以後也不要失去這顆誠實的心！"
@ TALK "還有這峽谷茶葉我會好好用它，謝謝你啦！"
@ REMOVE ITEM 213
@ REMOVE NUM_TO_ALL 108
@ REMOVE_ORDER 54
@ WAIT
@ END

* 峽谷茶1-2
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "是嗎？"
@ TALK "好像記得是5000銅幣？？"
@ TALK "不管怎樣……，給你6000銅幣吧！"
@ GIVE MONEY 6000
@ WAIT
@ CLEAR_BUFFER
@ TALK "還有峽谷茶葉我會好好用它的！"
@ REMOVE ITEM 213
@ REMOVE NUM_TO_ALL 108
@ REMOVE_ORDER 54
@ WAIT
@ END

* 峽谷茶1-3
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "鐵匠" 200 250 0
@ COLOR 200 200 0
@ TALK "什麼！7000枚銅幣？！"
@ TALK "你在說什麼啊你！"
@ TALK "雖然說我的記憶力不好，"
@ TALK "可是也不可能連差這麼多錢都感覺不出來吧！"
@ TALK "反正…就給你5000枚銅幣吧！"
@ WAIT
@ TALK "做人不要這樣……，"
@ TALK "應該過的誠實一點。"
@ GIVE MONEY 5000
@ REMOVE ITEM 213
@ REMOVE NUM_TO_ALL 108
@ REMOVE_ORDER 54
@ WAIT
@ END

/--------------------------------------------------------
/村莊5的 商店老闆
# 2
# 8
# 2
# "商店老闆"
# BASIC
# 100
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "你好，請挑挑看。"
@ TALK "有需要的嗎？"
@ WAIT
@ IF NUM HAVE 151 THEN GO_DOWN 山蔘1
* 施主商店老闆
@ CLEAR_BUFFER
@ BOX BLUE 6
@ COLOR 250 250 0
@ PLAY 3.WAV
@ SELECT 250 250 255
CASE "買入裝備" GO_DOWN 挑選裝備1
CASE "賣出裝備" GO_DOWN 賣出裝備
CASE "買入道具" GO_DOWN 買入道具3
CASE "賣出道具" GO_DOWN 賣出道具
CASE "與店主對話" GO_DOWN T5-2
CASE "離開" GO_DOWN 結束
SELECT_END
@ END

* T5-2
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ SELECT 255 255 255
CASE "<關於魔怪>" GO_DOWN T5-A
CASE "<關於千鬼神>" GO_DOWN T5-B
CASE "<關於雷旗仵獅魔族> " GO_DOWN T5-C
CASE "<結束談話>" GO_UP 施主商店老闆
SELECT_END
@ END

* T5-A
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "周圍的魔怪？"
@ TALK "你知道你現在已來到了地下世界嗎？"
@ TALK "不過從有地上的人來到這裡的樣子來看，"
@ TALK "表示人類與魔族的戰爭也近了。"
@ TALK ""
@ WAIT
@ CLEAR_BUFFER
@ TALK "現在所有的魔族都在自己的地盤準備戰爭，"
@ TALK "表面上是攻打人界重要的戰爭，"
@ TALK "其實是地下世界的霸權之爭。"
@ TALK "也許，如果能魔族同心協力的話，"
@ TALK "人界可能早已落在它們手中了。"
@ WAIT
@ CLEAR_BUFFER
@ SELECT 255 255 255
CASE "<關於千鬼神手下的魔族>" GO_DOWN T5-A-1
SELECT_END
@ END

* T5-A-1
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "千鬼神的手下魔族的話……。"
@ TALK "在西方的城中的雙頭魔神。"
@ TALK "它在過去千鬼神取得魔界霸權的戰爭中，"
@ TALK "立下了輝煌的功勞。"
@ TALK "千鬼神在被封印時雙頭魔神取得它一半的力量。"
@ TALK "在東方之城的秤魔王。"
@ TALK "它以可怕的威力讓魔怪們活在恐懼之中。"
@ TALK "它得到千鬼神另一半的力量。它倆是代表魔界的魔族。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "它們雖然原本是千鬼神的手下，"
@ TALK "但在千鬼神被封印後，分得到千鬼神能力的兩人。"
@ TALK "就把地下世界分成兩半分別佔有了。"
@ WAIT
@ GO_UP T5-2
@ END

* T5-B
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "千鬼神？"
@ TALK "當然千鬼神被稱為魔族有史以來最偉大的君王，"
@ TALK "不過現在它已不行了。"
@ TALK "把自己所有的力量分給手下的千鬼神，"
@ TALK "已無法再掌控它的屬下。"
@ TALK "現在的它已失去了力量，"
@ TALK "聽說正隱居在某個地方……。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "也有謠言說"
@ TALK "它在地上世界得到了痛哭之劍…。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "不過……，"
@ TALK "也許千鬼神才是真正希望魔族間起戰爭的。"
@ TALK "因為要等雙頭魔神和秤魔王死後，"
@ TALK "千鬼神才有辦法拿回原本屬於自己的能力。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "在千鬼神把自己的能力分給雙頭魔神與秤魔王後，"
@ TALK "受到背叛的事你也知道吧？"
@ WAIT
@ GO_UP T5-2 

* T5-C
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "雷旗仵獅魔族的話，"
@ TALK "你是指魔女蕾蒂娜和魔道士雷旗仵獅吧？"
@ TALK "他們是這魔界裡偉大的人物。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "但是受到雙頭魔神和秤魔王的超級詛咒，"
@ TALK "他們已經沒有任何力量了。"
@ TALK "以往那些魔怪對他們的魔力萬分懼怕，"
@ TALK "也許拖到現在才有攻打人界的行動，"
@ TALK "就是因為雷旗仵獅魔族他們在守著。"
@ CLEAR_BUFFER
@ TALK "不過，現在的他們已失去所有的力量，"
@ TALK "世界會將變什麼樣子，沒有人會知道……。"
@ WAIT
@ GO_UP T5-2 


* 山蔘1
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "<談關於山蔘的事>" GO_DOWN 山蔘2
CASE "<談關於物品的事>" GO_UP 施主商店老闆
CASE "<離開>" GO_DOWN 結束仲介
SELECT_END

* 山蔘2
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "請問這裡有賣山蔘嗎？！"
@ TALK "我有急事…。"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "山蔘？"
@ TALK "山蔘的話…。我是有一根…。"
@ TALK "不過…，山蔘可是很難取得的珍貴藥材……。"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "拜託你！"
@ TALK "請幫幫忙！！"
@ TALK "這關係到一個女孩的性命。"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "唉…我是知道你很急啦！"
@ TALK "只是山蔘真的太難拿得到了…，"
@ TALK "如果給10000枚銅幣也許說不定……？"
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "<付錢>" GO_DOWN 山蔘1-1
CASE "<不付錢>" GO_DOWN 山蔘1-2
SELECT_END

* 山蔘1-1
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ IF MONEY GE 10000 THEN GO_DOWN 山蔘OK
@ TALK "什麼你連一毛錢都沒有還想要買東西？"
@ TALK "開什麼玩笑，"
@ TALK "快給我滾蛋！"
@ WAIT
@ END

* 山蔘1-2
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ TALK "是嗎？你不要也沒辦法……。"
@ TALK "不要怪我！"
@ TALK "我也是個商人想賺取利益也是應該的，"
@ TALK "那…你慢走！"
@ WAIT
@ END

* 山蔘OK
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "商店老闆" 250 220 0
@ COLOR 250 220 0
@ REMOVE MONEY 10000
@ GIVE ITEM 168 1
@ TALK "來！山蔘在這兒！"
@ TALK "賣這麼便宜，我也有點捨不得……。"
@ TALK "真的是很難取得到呢。"
@ TALK "不管怎樣，希望你用在有用的地方。"
@ TALK "這可是很珍貴的東西呢。"
@ REMOVE NUM_TO_ALL 151
@ WAIT
@ END

/--------------------------------------------------------
* 村莊5之魔女
# 3
# 8
# 3
# "魔女"
# BASIC
# 100
* 施主魔女
@ CLEAR_BUFFER
@ COLOR 240 20 190
@ IF LEARN_MAGIC THEN GO_DOWN MAGIC_STOP
@ BOX BLUE 5
@ FACE 6 "魔法所魔女" 240 20 190
@ TALK "找我有什麼事嗎？"
@ WAIT
@ CLEAR_BUFFER
@ COLOR 250 250 0
@ PLAY 7.WAV
@ SELECT 250 250 250
CASE "<與老闆談話>" GO_DOWN T5-3
CASE "<魔法訓練>" GO_DOWN 魔法訓練1
CASE "<離開>" GO_DOWN 結束
SELECT_END

* T5-3
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 6 "魔法所魔女" 240 20 190
@ COLOR 240 20 190
@ TALK "連買個東西都沒，就開始問問題了。"
@ TALK "那…好吧，也很久沒看到地上人了。"
@ TALK "幫你看看吧！"
@ WAIT

* T5-3A
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 6 "魔法所魔女" 240 20 190
@ COLOR 240 20 190
@ SELECT 255 255 255
CASE "<關於雙頭魔神>" GO_DOWN T5-3-1
CASE "<關於秤魔王>" GO_DOWN T5-3-2
CASE "<關於雷旗仵獅魔族>" GO_DOWN T5-3-3
CASE "<結束談話>" GO_UP 施主魔女
SELECT_END
@END

* T5-3-1
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 6 "魔法所魔女" 240 20 190
@ COLOR 240 20 190
@ TALK "雙頭魔神的話，"
@ TALK "是擁有西方的城鎮的魔族。"
@ TALK "要去雙頭魔神的城需要從魔城山峰通過異魔王洞才可以。"
@ TALK "不過洞口被魔怪們佔據著，"
@ TALK "要進去恐怕很難。"
@ WAIT
@ GO_UP T5-3A 

* T5-3-2
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 6 "魔法所魔女" 240 20 190
@ COLOR 240 20 190
@ TALK "真不知道，"
@ TALK "我為什麼要告訴你這些事…。"
@ TALK "不管怎樣，東方的城鎮是秤魔王的勢力範圍。"
@ TALK "要去東方城的話，"
@ TALK "往我們村的東北方走去就可以了。"
@ TALK "不過，那邊也是被魔怪佔有了。"
@ WAIT
@ GO_UP T5-3A

* T5-3-3
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 6 "魔法所魔女" 240 20 190
@ COLOR 240 20 190
@ TALK "你剛剛是在問雷旗仵獅家族的事嗎？！"
@ TALK "要說雷旗仵獅家族，"
@ TALK "當然不能忽略掉偉大的魔女蕾蒂娜！"
@ WAIT
@ CLEAR_BUFFER
@ TALK "那位女士慈祥的品性和魔力是…，"
@ TALK "那些魔族是根本無法直視的。"
@ WAIT
@ TALK "但是就因為這樣那些魔怪…。"
@ TALK "唉！詛咒…。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "算了，只會越講越生氣！"
@ WAIT
@ GO_UP T5-3A

