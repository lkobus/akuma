* T5-3
/ 與西域村之魔女的對話
@ CLEAR_BUFFER
@ SELECT 255 255 255
CASE "<關於村莊的傳聞>" GO_DOWN T3-3-1
CASE "<關於藥效>" GO_DOWN T3-3-2
