* T4-2
@ CLEAR_BUFFFER
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "<關於痛哭之劍>" GO_DOWN T3-2-1
CASE "<關於村莊的傳說>" GO_DOWN T3-2-2
