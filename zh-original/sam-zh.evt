@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 5 "道具商人" 250 200 0
@ COLOR 250 200 0
@ TALK "你好，需要什麼嗎？"
@ TALK "  "
@ COLOR 250 250 0
@ PLAY 5.WAV
@ SELECT 255 255 255
CASE "買入道具" GO_DOWN 買入道具1
CASE "賣出道具" GO_DOWN 賣出道具
CASE "離開" GO_DOWN 結束
SELECT_END

* STEP1
@ BOX BLUE 5
@ FACE 5 "道具商人" 250 200 0
@ COLOR 250 200 0
@ TALK "你好，需要什麼嗎？"
@ TALK "  "
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "買入道具" GO_DOWN 買入道具1
CASE "關於村莊周遭的對話" GO_DOWN T1-2-1
CASE "離開" GO_DOWN 結束
SELECT_END
* T1-2-1
/ 與道具商人的對話
@ CLEAR_BUFFER
@ GIVE NUM 31
@ TALK "你想要到河對岸去？"
@ TALK "嘖嘖……"
@ TALK "如果是這樣的話，你還是放棄這念頭較好。"
@ TALK "因為……，"
@ TALK "黃天江周圍已集滿了魔怪……。"
@ WAIT
@ CLEAR_BUFFER
@ TALK "以前兩地還往返的很活躍呢！"
@ TALK "不過不知從何時起……，"
@ TALK "魔怪開始聚集在黃天江附近，"
@ TALK "從那時起人們就無法自由往來了。"
@ TALK "雖然你要過江是你的自由，"
@ TALK "但千萬要小心。"
@ TALK "在這村莊也已經有很多人犧牲了呢……。"
@ WAIT
@ GO_UP 道具商人指令1
@ END


