@ TALK "和清流之戒。"
@ TALK "這樣的報酬更合你的意吧？"
@ WAIT
@ CLEAR_BUFFER
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ SELECT 255 255 255
