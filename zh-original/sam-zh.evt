@ TALK "因為不知道魔怪何時會攻進來，"
@ TALK "魔怪若攻進來的話。"
@ TALK "我將會與它們作戰壯烈的死去！"
@ WAIT
@ CLEAR_BUFFER
@ TALK "這世界還是有存在著"
@ TALK "不畏懼魔怪的人。"
@ TALK "假如你也看到魔怪……。"
@ TALK "要抱持著無懼的心去對抗"
@ TALK "這樣就能贏！"
@ WAIT
@ CLEAR_BUFFER
@ TALK "曾有人說過："
@ TALK "“天助自助者，否則將天誅地滅！”"
@ WAIT
@ CHANGE 0
@ GO_BASIC_EVENT
@ END














